# Copy this file to .env for local development.
# Do not commit real private keys or funded wallet secrets.

# Optional API override. The CLI defaults to this x402-enabled local API.
BITCOINAGENT_API_URL=http://localhost:8082

# Required for the wallet command and x402 payment signing.
AGENTSATS_WALLET_PROVIDER=private-key
STACKS_NETWORK=testnet
STACKS_PRIVATE_KEY=

# Optional Open Wallet Standard wallet provider.
# Set AGENTSATS_WALLET_PROVIDER=ows to use a local OWS vault wallet.
OWS_WALLET=
OWS_CHAIN=stacks:2147483648
OWS_CLI=ows
OWS_PASSPHRASE=
