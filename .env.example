# Copy this file to .env for environment-based CLI configuration.
# Do not commit real private keys or funded wallet secrets.

# Optional API override. The CLI defaults to this hosted x402 API.
BITCOINAGENT_API_URL=https://agentsats.stacksx402.com/

# Required for the wallet command and x402 payment signing.
AGENTSATS_WALLET_PROVIDER=private-key
STACKS_NETWORK=mainnet
STACKS_PRIVATE_KEY=

# Optional Open Wallet Standard wallet provider.
# Set AGENTSATS_WALLET_PROVIDER=ows to use an OWS vault wallet.
# You can also create saved non-secret OWS config with:
# npx agentsats wallet setup --provider ows --preview-stacks --wallet agentsats-mainnet --network mainnet
OWS_WALLET=
OWS_CHAIN=stacks:1
OWS_CLI=ows
# OWS Stacks mnemonic wallets currently derive uncompressed Stacks addresses by default.
# Use "compressed" only for an imported compressed Stacks private key wallet.
OWS_STACKS_KEY_ENCODING=uncompressed
OWS_PASSPHRASE=

# Optional AgentSats config/cache overrides.
# Defaults to ~/.agentsats/config.json and ~/.agentsats/ows/...
AGENTSATS_HOME=
AGENTSATS_CONFIG_PATH=
