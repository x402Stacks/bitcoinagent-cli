{
  "name": "agentsats",
  "version": "0.1.2",
  "description": "AgentSats CLI for Bitcoin-paid agent workflows with human and machine-safe output modes.",
  "type": "module",
  "bin": {
    "agentsats": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"Lint not configured yet\"",
    "completions:generate": "pnpm build && node dist/index.js complete"
  },
  "dependencies": {
    "@bomb.sh/tab": "^0.0.14",
    "@clack/prompts": "^1.2.0",
    "@stacks/network": "^6.17.0",
    "@stacks/transactions": "^6.17.0",
    "axios": "^1.15.0",
    "commander": "^13.1.0",
    "x402-stacks": "^2.0.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.18.3"
}
