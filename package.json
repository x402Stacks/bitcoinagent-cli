{
  "name": "agent-cli",
  "version": "0.1.0",
  "description": "Agent-first TypeScript CLI starter with human and machine-safe output modes.",
  "type": "module",
  "bin": {
    "agent-cli": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"Lint not configured yet\"",
    "completions:generate": "pnpm build && node dist/index.js complete"
  },
  "dependencies": {
    "@bomb.sh/tab": "^0.0.14",
    "@clack/prompts": "^1.2.0",
    "axios": "^1.15.0",
    "commander": "^13.1.0",
    "x402-stacks": "^1.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.18.3"
}
